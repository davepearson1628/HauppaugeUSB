+/*
+ * One-shot MDP image capture.
+ *
+ * Hauppauge itself does NOT perform any image recognition.
+ *
+ * When enabled, an external process requests a snapshot by creating:
+ *
+ *     <mdp_image>.request
+ *
+ * Example:
+ *
+ *     mdp_image=/run/hauppauge2/mdp-live.jpg
+ *
+ * Request:
+ *
+ *     /run/hauppauge2/mdp-live.jpg.request
+ *
+ * After mdp_delay milliseconds, encoded MPEG-TS data is copied to a
+ * temporary FFmpeg process. FFmpeg decodes one video frame and writes
+ * it to a temporary file. The completed image is then atomically
+ * renamed to mdp_image.
+ *
+ * The normal MPEG-TS output path is never redirected through FFmpeg.
+ */
+
+
+class MDPSnapshot
+{
+  public:
+    MDPSnapshot()
+        : m_enabled(false)
+        , m_delay_ms(1500)
+        , m_run(true)
+        , m_capture_active(false)
+    {
+        /*
+         * The MDP FFmpeg process can exit as soon as it has decoded its
+         * single requested frame. Ignore SIGPIPE so a write to the closed
+         * FFmpeg pipe cannot terminate hauppauge2.
+         */
+        signal(SIGPIPE, SIG_IGN);
+
+        m_thread = std::thread(&MDPSnapshot::run, this);
+    }
+
+    ~MDPSnapshot()
+    {
+        m_run = false;
+        m_cond.notify_all();
+
+        if (m_thread.joinable())
+            m_thread.join();
+    }
+
+    void configure(bool enabled,
+                   const std::string &image,
+                   int delay_ms)
+    {
+        m_enabled = enabled;
+        m_image = image;
+
+        if (delay_ms < 0)
+            delay_ms = 0;
+
+        m_delay_ms = delay_ms;
+
+        if (m_image.empty())
+            m_enabled = false;
+
+        if (m_enabled)
+            ensure_parent_directory();
+
+        m_cond.notify_all();
+    }
+
+    void feed(void *data, size_t len)
+    {
+        if (!m_capture_active || !data || len == 0)
+            return;
+
+        std::vector<uint8_t> block(
+            reinterpret_cast<uint8_t *>(data),
+            reinterpret_cast<uint8_t *>(data) + len
+        );
+
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+
+            /*
+             * Never permit the MDP side-channel to consume unbounded
+             * memory if FFmpeg becomes stuck.
+             *
+             * 256 x ~64 KiB is approximately 16 MiB.
+             */
+            if (m_queue.size() >= 256)
+                m_queue.pop_front();
+
+            m_queue.push_back(std::move(block));
+        }
+
+        m_cond.notify_all();
+    }
+
+  private:
+    bool request_exists() const
+    {
+        if (!m_enabled || m_image.empty())
+            return false;
+
+        std::string request = request_file();
+
+        struct stat st;
+
+        return (::stat(request.c_str(), &st) == 0);
+    }
+
+    std::string request_file() const
+    {
+        return m_image + ".request";
+    }
+
+    std::string temporary_image() const
+    {
+        return m_image + ".tmp";
+    }
+
+    void ensure_parent_directory()
+    {
+        std::size_t slash = m_image.find_last_of('/');
+
+        if (slash == std::string::npos || slash == 0)
+            return;
+
+        std::string dir = m_image.substr(0, slash);
+
+        /*
+         * This is intentionally simple. For the intended path:
+         *
+         *     /run/hauppauge2/mdp-live.jpg
+         *
+         * /run already exists, so only /run/hauppauge2 needs creating.
+         */
+        if (::mkdir(dir.c_str(), 0755) < 0 && errno != EEXIST)
+        {
+            /*
+             * Failure will be apparent when FFmpeg cannot create the
+             * requested output image.
+             */
+        }
+    }
+
+    bool write_all(int fd,
+                   const uint8_t *data,
+                   size_t len)
+    {
+        size_t done = 0;
+
+        while (done < len)
+        {
+            ssize_t ret = ::write(fd, data + done, len - done);
+
+            if (ret > 0)
+            {
+                done += static_cast<size_t>(ret);
+                continue;
+            }
+
+            if (ret < 0 && errno == EINTR)
+                continue;
+
+            return false;
+        }
+
+        return true;
+    }
+
+    pid_t start_ffmpeg(int &pipe_fd)
+    {
+        int pipefd[2];
+
+        if (::pipe(pipefd) < 0)
+            return -1;
+
+        pid_t pid = ::fork();
+
+        if (pid < 0)
+        {
+            ::close(pipefd[0]);
+            ::close(pipefd[1]);
+            return -1;
+        }
+
+        if (pid == 0)
+        {
+            /*
+             * Child.
+             *
+             * MPEG-TS arrives on stdin.
+             */
+            ::dup2(pipefd[0], STDIN_FILENO);
+
+            ::close(pipefd[0]);
+            ::close(pipefd[1]);
+
+            int nullfd = ::open("/dev/null", O_WRONLY);
+
+            if (nullfd >= 0)
+            {
+                ::dup2(nullfd, STDOUT_FILENO);
+                ::close(nullfd);
+            }
+
+            std::string tmp = temporary_image();
+
+            execlp(
+                "ffmpeg",
+                "ffmpeg",
+                "-hide_banner",
+                "-loglevel", "error",
+                "-nostdin",
+                "-f", "mpegts",
+                "-i", "pipe:0",
+                "-map", "0:v:0",
+                "-frames:v", "1",
+                "-q:v", "2",
+                "-c:v", "mjpeg",
+                "-f", "image2",
+                "-y",
+                tmp.c_str(),
+                static_cast<char *>(nullptr)
+            );
+
+            _exit(127);
+        }
+
+        /*
+         * Parent.
+         */
+        ::close(pipefd[0]);
+
+        pipe_fd = pipefd[1];
+
+        return pid;
+    }
+
+    void perform_capture()
+    {
+        /*
+         * Discard any queued data. We specifically want MPEG-TS data
+         * arriving AFTER mdp_delay has expired.
+         */
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            m_queue.clear();
+        }
+
+        int ffmpeg_fd = -1;
+
+        pid_t ffmpeg_pid = start_ffmpeg(ffmpeg_fd);
+
+        if (ffmpeg_pid < 0)
+            return;
+
+        m_capture_active = true;
+
+        auto deadline =
+            std::chrono::steady_clock::now() +
+            std::chrono::seconds(10);
+
+        bool write_failed = false;
+        bool child_finished = false;
+        int child_status = 0;
+
+        while (m_run &&
+               std::chrono::steady_clock::now() < deadline)
+        {
+            std::vector<uint8_t> block;
+
+            {
+                std::unique_lock<std::mutex> lock(m_mutex);
+
+                m_cond.wait_for(
+                    lock,
+                    std::chrono::milliseconds(100),
+                    [this]()
+                    {
+                        return !m_queue.empty() || !m_run;
+                    }
+                );
+
+                if (!m_queue.empty())
+                {
+                    block = std::move(m_queue.front());
+                    m_queue.pop_front();
+                }
+            }
+
+            if (!block.empty())
+            {
+                if (!write_all(
+                        ffmpeg_fd,
+                        block.data(),
+                        block.size()))
+                {
+                    write_failed = true;
+                }
+            }
+
+            pid_t ret = ::waitpid(
+                ffmpeg_pid,
+                &child_status,
+                WNOHANG
+            );
+
+            if (ret == ffmpeg_pid)
+            {
+                child_finished = true;
+                break;
+            }
+
+            if (write_failed)
+            {
+                /*
+                 * FFmpeg normally closes its stdin after producing the
+                 * requested frame, so a failed pipe write may simply mean
+                 * that the child has completed.
+                 */
+                for (int i = 0; i < 20; ++i)
+                {
+                    ret = ::waitpid(
+                        ffmpeg_pid,
+                        &child_status,
+                        WNOHANG
+                    );
+
+                    if (ret == ffmpeg_pid)
+                    {
+                        child_finished = true;
+                        break;
+                    }
+
+                    std::this_thread::sleep_for(
+                        std::chrono::milliseconds(10)
+                    );
+                }
+
+                break;
+            }
+        }
+
+        m_capture_active = false;
+
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            m_queue.clear();
+        }
+
+        if (ffmpeg_fd >= 0)
+            ::close(ffmpeg_fd);
+
+        if (!child_finished)
+        {
+            /*
+             * Give FFmpeg a short opportunity to exit after stdin closes.
+             */
+            for (int i = 0; i < 20; ++i)
+            {
+                pid_t ret = ::waitpid(
+                    ffmpeg_pid,
+                    &child_status,
+                    WNOHANG
+                );
+
+                if (ret == ffmpeg_pid)
+                {
+                    child_finished = true;
+                    break;
+                }
+
+                std::this_thread::sleep_for(
+                    std::chrono::milliseconds(25)
+                );
+            }
+        }
+
+        if (!child_finished)
+        {
+            ::kill(ffmpeg_pid, SIGTERM);
+            ::waitpid(ffmpeg_pid, &child_status, 0);
+        }
+
+        std::string tmp = temporary_image();
+
+        if (child_finished &&
+            WIFEXITED(child_status) &&
+            WEXITSTATUS(child_status) == 0)
+        {
+            /*
+             * Atomic publication of the completed image.
+             */
+            ::rename(tmp.c_str(), m_image.c_str());
+        }
+        else
+        {
+            ::unlink(tmp.c_str());
+        }
+    }
+
+    void run()
+    {
+        while (m_run)
+        {
+            if (!m_enabled)
+            {
+                std::unique_lock<std::mutex> lock(m_mutex);
+
+                m_cond.wait_for(
+                    lock,
+                    std::chrono::milliseconds(250)
+                );
+
+                continue;
+            }
+
+            if (!request_exists())
+            {
+                std::unique_lock<std::mutex> lock(m_mutex);
+
+                m_cond.wait_for(
+                    lock,
+                    std::chrono::milliseconds(50)
+                );
+
+                continue;
+            }
+
+            /*
+             * Consume the request immediately. If another channel change
+             * occurs while this capture is in progress, a new .request
+             * file can be created and will be handled afterwards.
+             */
+            ::unlink(request_file().c_str());
+
+            if (m_delay_ms > 0)
+            {
+                auto remaining =
+                    std::chrono::milliseconds(m_delay_ms);
+
+                while (m_run &&
+                       remaining.count() > 0)
+                {
+                    auto chunk =
+                        std::min(
+                            remaining,
+                            std::chrono::milliseconds(100)
+                        );
+
+                    std::this_thread::sleep_for(chunk);
+
+                    remaining -= chunk;
+                }
+            }
+
+            if (!m_run)
+                break;
+
+            perform_capture();
+        }
+    }
+
+  private:
+    std::atomic<bool> m_enabled;
+    std::string       m_image;
+    int               m_delay_ms;
+
+    std::atomic<bool> m_run;
+    std::atomic<bool> m_capture_active;
+
+    std::thread              m_thread;
+    std::mutex               m_mutex;
+    std::condition_variable  m_cond;
+
+    std::deque<std::vector<uint8_t>> m_queue;
+};
+
+
+class DataTransfer
+{
+  public:
+    using callback_t = std::function<void(void*, size_t)>;
+
+  protected:
+    int        m_fd;
+    bool       m_own_fd;
+    callback_t m_cb;
+    bool       m_use_cb;
+
+    MDPSnapshot m_mdp;
+
+  public:
+    DataTransfer()
+        : m_fd(-1)
+        , m_own_fd(false)
+        , m_use_cb(false)
+    {
+    }
+
+    ~DataTransfer()
+    {
+        if (m_own_fd && m_fd > 0)
+            ::close(m_fd);
+    }
+
+    bool setFile(const char *fn)
+    {
+        if (m_own_fd && m_fd > 0)
+            ::close(m_fd);
+
+        if (!fn)
+            return true;
+
+        m_fd = ::open(
+            fn,
+            O_WRONLY | O_TRUNC | O_CREAT,
+            0666
+        );
+
+        m_own_fd = (m_fd >= 0);
+
+        return m_own_fd;
+    }
+
+    void setFD(int fd)
+    {
+        if (m_own_fd && m_fd > 0)
+            ::close(m_fd);
+
+        m_own_fd = false;
+        m_fd = fd;
+    }
+
+    void setCB(callback_t &cb)
+    {
+        m_cb = cb;
+        m_use_cb = true;
+    }
+
+    void setMDP(bool enabled,
+                const std::string &image,
+                int delay_ms)
+    {
+        m_mdp.configure(
+            enabled,
+            image,
+            delay_ms
+        );
+    }
+
+    void write(void *data, size_t len)
+    {
+        /*
+         * Existing output path first.
+         *
+         * The MDP side-channel must never become responsible for delivery
+         * of the main transport stream.
+         */
+        if (m_use_cb)
+            m_cb(data, len);
+
+        if (m_fd >= 0)
+            ::write(m_fd, data, len);
+
+        /*
+         * Copy to the MDP worker only while a requested snapshot is being
+         * produced.
+         */
+        m_mdp.feed(data, len);
+    }
+
+    static VOID static_BufferComplete(
+        void *p_context,
+        void *p_data,
+        size_t transfer_size)
+    {
+        DataTransfer *o =
+            reinterpret_cast<DataTransfer *>(p_context);
+
+        if (o)
+            o->write(
+                p_data,
+                transfer_size
+            );
+    }
 };
 
